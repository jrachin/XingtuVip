<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.xt.vip.xposed"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:hasCode="true"
        android:label="@string/module_name"
        android:supportsRtl="true">

        <!-- libxposed API 101 通过 META-INF/xposed/module.prop 识别模块；
             以下 meta-data 保留给仍读取旧约定的加载器，用于显示与兼容。 -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/module_description" />
        <meta-data android:name="xposedminversion" android:value="101" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
    </application>
</manifest>
